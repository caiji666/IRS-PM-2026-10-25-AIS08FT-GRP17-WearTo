# Copy to .env locally. Never commit real credentials.
# Install the provider integration before using a live model.
AGENT_MODEL=
OPENAI_API_KEY=

# Server-managed user portrait uploads. Keep uploaded portraits out of Git.
PORTRAIT_UPLOAD_ROOT=runtime/uploads/portraits

# Optional path for the daily ECB reference-rate cache used by Student 5.
ECB_FX_CACHE_PATH=runtime/cache/ecb_fx_rates.json

# Optional Student 1 database backend. Keep credentials local.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
ACTIVITY_KG_VERSION=0.2.0
# Model weights belong in ignored local storage. The runbook sets HF_HOME explicitly.

# Student 2 
# Unsplash API Credentials - Replace the placeholder with your actual Unsplash Access Key.
UNSPLASH_ACCESS_KEY=your_actual_unsplash_access_key

# Optional public historical climate cache. No weather API key is needed.
# Leave unset to build artifacts/weather/climatology.sqlite3 from the shared snapshot.
# WEATHER_CLIMATE_DB=/absolute/path/to/climatology.sqlite3

# Optional real preview for the local WearTo website (paid image API).
# The live runner separately reads Unsplash from .secrets/unsplash.env
# and eBay Production from .secrets/ebay-production.json.
PREVIEW_PROVIDER=openai
PREVIEW_API_KEY=
PREVIEW_MODEL=gpt-image-2.5-sunburst
PREVIEW_ALLOWED_IMAGE_HOSTS=i.ebayimg.com,images.unsplash.com
