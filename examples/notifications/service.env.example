# Configure these as platform secrets/environment variables; do not commit real values.
EBAY_ENVIRONMENT=production
EBAY_NOTIFICATION_ENDPOINT=https://YOUR_DEPLOYED_SERVICE/ebay/account-deletion
EBAY_NOTIFICATION_DB=/var/lib/ebay/notifications.sqlite3
EBAY_CLIENT_ID=YOUR_PRODUCTION_APP_ID
EBAY_CLIENT_SECRET=YOUR_PRODUCTION_CERT_ID
EBAY_VERIFICATION_TOKEN=YOUR_GENERATED_VERIFICATION_TOKEN
EBAY_QUEUE_KEY=YOUR_GENERATED_FERNET_KEY
EBAY_WORKER_TOKENS_JSON='{"mac":"YOUR_GENERATED_MAC_WORKER_TOKEN"}'
