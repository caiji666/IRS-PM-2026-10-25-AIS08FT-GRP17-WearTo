{
  "$defs": {
    "Availability": {
      "enum": [
        "UNKNOWN",
        "IN_STOCK",
        "OUT_OF_STOCK"
      ],
      "title": "Availability",
      "type": "string"
    },
    "Category": {
      "enum": [
        "TOP",
        "BOTTOM",
        "FOOTWEAR",
        "OUTERWEAR",
        "UNKNOWN"
      ],
      "title": "Category",
      "type": "string"
    },
    "Embedding": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "model",
        "values"
      ],
      "title": "Embedding",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "price_verified": {
          "default": false,
          "title": "Price Verified",
          "type": "boolean"
        },
        "availability_verified": {
          "default": false,
          "title": "Availability Verified",
          "type": "boolean"
        },
        "sizes_verified": {
          "default": false,
          "title": "Sizes Verified",
          "type": "boolean"
        },
        "image_verified": {
          "default": false,
          "title": "Image Verified",
          "type": "boolean"
        },
        "product_url_verified": {
          "default": false,
          "title": "Product Url Verified",
          "type": "boolean"
        },
        "category_verified": {
          "default": false,
          "title": "Category Verified",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "GroupedRankingReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "m6.grouped.1",
          "default": "m6.grouped.1",
          "title": "Schema Version",
          "type": "string"
        },
        "social_aggregation": {
          "const": "max",
          "default": "max",
          "title": "Social Aggregation",
          "type": "string"
        },
        "k_per_category": {
          "maximum": 1000,
          "minimum": 1,
          "title": "K Per Category",
          "type": "integer"
        },
        "ranked_products": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/RankedProduct"
            },
            "type": "array"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "Ranked Products",
          "type": "object"
        },
        "total_matches_per_category": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "Total Matches Per Category",
          "type": "object"
        },
        "total_matches": {
          "minimum": 0,
          "title": "Total Matches",
          "type": "integer"
        },
        "excluded_unknown_matches": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded Unknown Matches",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "k_per_category",
        "ranked_products",
        "total_matches_per_category",
        "total_matches"
      ],
      "title": "GroupedRankingReport",
      "type": "object"
    },
    "IndexedProduct": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "#/$defs/NormalizedProduct"
        },
        "vector": {
          "$ref": "#/$defs/Vector"
        },
        "encoding_reason": {
          "title": "Encoding Reason",
          "type": "string"
        }
      },
      "required": [
        "product",
        "vector",
        "encoding_reason"
      ],
      "title": "IndexedProduct",
      "type": "object"
    },
    "NormalizedProduct": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "raw_category": {
          "minLength": 1,
          "title": "Raw Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType",
          "default": "PREPARED_CATALOGUE"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Price"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sizes": {
          "items": {
            "type": "string"
          },
          "title": "Sizes",
          "type": "array"
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "UNKNOWN"
        },
        "image_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Path"
        },
        "product_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Url"
        },
        "embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embedding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "colors": {
          "items": {
            "type": "string"
          },
          "title": "Colors",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "image_embedding_candidate": {
          "default": false,
          "title": "Image Embedding Candidate",
          "type": "boolean"
        }
      },
      "required": [
        "product_id",
        "title",
        "raw_category",
        "category",
        "provenance"
      ],
      "title": "NormalizedProduct",
      "type": "object"
    },
    "Prediction": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "top_similarity": {
          "title": "Top Similarity",
          "type": "number"
        },
        "margin": {
          "title": "Margin",
          "type": "number"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "similarities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Similarities",
          "type": "object"
        },
        "method": {
          "default": "FashionCLIP zero-shot cosine; uncalibrated heuristic thresholds",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "label",
        "top_similarity",
        "margin",
        "accepted",
        "similarities"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Price",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "record_index": {
          "minimum": 1,
          "title": "Record Index",
          "type": "integer"
        },
        "original": {
          "additionalProperties": true,
          "title": "Original",
          "type": "object"
        }
      },
      "required": [
        "source",
        "record_index",
        "original"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RankedProduct": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "$ref": "#/$defs/IndexedProduct"
        },
        "score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Score",
          "type": "number"
        },
        "context_similarity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Similarity"
        },
        "social_similarity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Social Similarity"
        },
        "context_weight": {
          "title": "Context Weight",
          "type": "number"
        },
        "social_weight": {
          "title": "Social Weight",
          "type": "number"
        }
      },
      "required": [
        "item",
        "score",
        "context_weight",
        "social_weight"
      ],
      "title": "RankedProduct",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "PREPARED_CATALOGUE",
        "WARDROBE",
        "ECOMMERCE_API"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "UnifiedItem": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "raw_category": {
          "minLength": 1,
          "title": "Raw Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType",
          "default": "PREPARED_CATALOGUE"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Price"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sizes": {
          "items": {
            "type": "string"
          },
          "title": "Sizes",
          "type": "array"
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "UNKNOWN"
        },
        "image_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Path"
        },
        "product_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Url"
        },
        "embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Embedding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "colors": {
          "items": {
            "type": "string"
          },
          "title": "Colors",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "image_embedding_candidate": {
          "default": false,
          "title": "Image Embedding Candidate",
          "type": "boolean"
        },
        "subcategory": {
          "default": "UNKNOWN",
          "title": "Subcategory",
          "type": "string"
        },
        "styles": {
          "items": {
            "type": "string"
          },
          "title": "Styles",
          "type": "array"
        },
        "style_status": {
          "default": "UNKNOWN",
          "enum": [
            "PREDICTED",
            "UNKNOWN"
          ],
          "title": "Style Status",
          "type": "string"
        },
        "owned": {
          "default": false,
          "title": "Owned",
          "type": "boolean"
        },
        "ownership_source": {
          "anyOf": [
            {
              "const": "user_upload",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Source"
        },
        "additional_purchase_required": {
          "default": true,
          "title": "Additional Purchase Required",
          "type": "boolean"
        },
        "garment_embedding": {
          "$ref": "#/$defs/Vector"
        },
        "attribute_predictions": {
          "additionalProperties": {
            "$ref": "#/$defs/Prediction"
          },
          "title": "Attribute Predictions",
          "type": "object"
        }
      },
      "required": [
        "product_id",
        "title",
        "raw_category",
        "category",
        "provenance",
        "garment_embedding"
      ],
      "title": "UnifiedItem",
      "type": "object"
    },
    "Vector": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "modality": {
          "enum": [
            "text",
            "image"
          ],
          "title": "Modality",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "model",
        "modality",
        "values"
      ],
      "title": "Vector",
      "type": "object"
    },
    "WardrobeIssue": {
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "title": "Upload Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "upload_id",
        "reason"
      ],
      "title": "WardrobeIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "phase2.1",
      "default": "phase2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "owned_items": {
      "items": {
        "$ref": "#/$defs/UnifiedItem"
      },
      "title": "Owned Items",
      "type": "array"
    },
    "top_k_products": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/UnifiedItem"
        },
        "type": "array"
      },
      "title": "Top K Products",
      "type": "object"
    },
    "product_ranking": {
      "$ref": "#/$defs/GroupedRankingReport"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/WardrobeIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "owned_items",
    "top_k_products",
    "product_ranking"
  ],
  "title": "Phase2Bundle",
  "type": "object"
}
